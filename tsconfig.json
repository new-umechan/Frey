{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path Aliases (if needed) */
    "baseUrl": ".",
    "paths": {
      "@wasm/*": ["generated/wasm/web/*"]
    }
  },
  "include": ["web/src", "web/tests", "tools", "benches/scripts", "tests/perf/scripts", "tests/seed-regression/scripts", "generated/wasm/web/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
