{
    "name": "frey-day020",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "terrain-params:sync": "node scripts/sync-terrain-params.mjs",
        "dev": "npm run terrain-params:sync && node scripts/dev-hotreload.mjs",
        "build": "npm run wasm:build && vite build",
        "preview": "vite preview",
        "wasm:build": "npm run terrain-params:sync && wasm-pack build rust --target web --out-dir ../src/wasm --release",
        "wasm:build:dev": "npm run terrain-params:sync && wasm-pack build rust --target web --out-dir ../src/wasm --dev",
        "wasm:build:dev:no-sync": "wasm-pack build rust --target web --out-dir ../src/wasm --dev"
    },
    "dependencies": {
        "three": "^0.180.0"
    },
    "devDependencies": {
        "vite": "^7.1.9"
    }
}
