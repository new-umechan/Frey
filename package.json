{
    "name": "frey",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "runtime:sync": "node tools/sync/sync-runtime-params.mjs",
        "terrain:sync": "node tools/sync/sync-terrain-params.mjs",
        "runtime-params:sync": "npm run runtime:sync",
        "terrain-params:sync": "npm run terrain:sync",
        "dev": "npm run runtime:sync && npm run terrain:sync && node tools/dev/dev-hotreload.mjs",
        "build": "npm run runtime:sync && npm run wasm:build && vite build --config web/vite.config.js",
        "preview": "vite preview --config web/vite.config.js",
        "lint:web": "eslint \"web/src/**/*.js\"",
        "lint:rust": "cargo clippy --manifest-path rust/Cargo.toml --all-targets",
        "lint:prepush": "npm run lint:web && npm run lint:rust",
        "hooks:install": "node tools/dev/install-git-hooks.mjs",
        "bench": "node benches/scripts/bench.mjs",
        "bench:tui": "node benches/scripts/tui-dashboard.mjs",
        "perf:run": "node tests/perf/scripts/perf.mjs",
        "perf:run:dev": "npm run wasm:build:dev:no-sync && node tests/perf/scripts/perf.mjs",
        "perf:baseline": "npm run perf:run:dev -- --ticks 16 --seed alpha --no-geometry --sample-interval 4 --out tests/perf/bench-baseline.json",
        "perf:gate": "npm run perf:run:dev -- --ticks 16 --seed alpha --no-geometry --sample-interval 4 --baseline tests/perf/bench-baseline.json --threshold 0.1",
        "seed:regression": "node tests/seed-regression/scripts/seed-regression.mjs",
        "seed:regression:dev": "npm run wasm:build:dev:no-sync && node tests/seed-regression/scripts/seed-regression.mjs",
        "seed:gate:quick": "npm run seed:regression:dev -- --seeds alpha,beta,gamma,delta --ticks 16 --baseline tests/seed-regression/seed-regression-quick-baseline.json --check --threshold 0.005 --threshold-top10-river-flux-sum 0.01",
        "seed:gate:heavy": "npm run seed:regression:dev -- --seeds alpha,beta,gamma,delta,eta,theta,kappa,mu --ticks 24 --baseline tests/seed-regression/seed-regression-heavy-baseline.json --check --threshold 0.005 --threshold-top10-river-flux-sum 0.01",
        "bench:dump-centroids": "node benches/scripts/dump-cell-centroids.mjs --level 6 --out benches/data/cell_centroids.csv",
        "bench:fetch:era5": "CDSAPI_RC=.cdsapirc python3 benches/scripts/fetch-era5-land-monthly.py --start-year 1970 --end-year 2000 --out benches/raw/climate/era5_land_monthly_1970_2000.zip",
        "bench:fetch:glofas": "CDSAPI_RC=.cdsapirc python3 benches/scripts/fetch-glofas-historical.py --start-year 1979 --end-year 1985 --out-dir benches/raw/hydrology/glofas_raw --system-version version_4_0 --hydrological-model lisflood --days 01,08,15,22,29",
        "bench:prepare:era5": "python3 benches/scripts/prepare-era5-land-climate.py --input benches/raw/climate/era5_land_monthly_1970_2000.zip --start-year 1970 --end-year 2000 --out benches/raw/climate/era5_land_annual_1970_2000.nc",
        "bench:prepare:glofas": "python3 benches/scripts/prepare-glofas-hydrology.py --input-dir benches/raw/hydrology/glofas_raw --output benches/raw/hydrology/glofas_era5_annual_mean.nc",
        "bench:prepare:ecology-modis": "PYTHONNOUSERSITE=1 /opt/homebrew/Caskroom/miniforge/base/bin/python benches/scripts/prepare-ecology-modis.py --mod44b-dir benches/raw/ecology/MOD44B --mcd12q1-dir benches/raw/ecology/MCD12Q1 --year 2019",
        "bench:prepare:soilgrids:0p1deg": "PYTHONNOUSERSITE=1 /opt/homebrew/Caskroom/miniforge/base/bin/python benches/scripts/prepare-soilgrids.py --out-dir benches/raw/ecology/soilgrids --resolution-deg 0.1",
        "bench:prepare:soilgrids:aggregate": "PYTHONNOUSERSITE=1 /opt/homebrew/Caskroom/miniforge/base/bin/python benches/scripts/aggregate-soilgrids-depth.py --in-dir benches/raw/ecology/soilgrids --out-dir benches/raw/ecology/soilgrids --suffix 0p1deg --w-0-5 5 --w-5-15 3.5 --w-15-30 1.5",
        "bench:prepare:worldclim": "python3 benches/scripts/prepare-worldclim-climate.py --input-dir benches/raw/climate --out-temperature benches/raw/climate/worldclim_tavg_annual_c.tif --out-precipitation benches/raw/climate/worldclim_prec_annual_mm.tif",
        "bench:resample:climate": "python3 benches/scripts/resample.py --module climate --centroids benches/data/cell_centroids.csv --output benches/data/climate_ref.bin",
        "bench:resample:ecology-ref": "python3 benches/scripts/resample.py --module ecology-ref --centroids benches/data/cell_centroids.csv --output benches/data/ecology_ref.bin --tree-cover benches/raw/ecology/mod44b_tree_cover.tif --non-tree-cover benches/raw/ecology/mod44b_non_tree_cover.tif --bare-cover benches/raw/ecology/mod44b_non_vegetated.tif --landcover benches/raw/ecology/mcd12q1_lc_type1.tif --landuse benches/raw/ecology/mcd12q1_lc_prop2.tif --temperature benches/raw/climate/worldclim_tavg_annual_c.tif --precipitation benches/raw/climate/worldclim_prec_annual_mm.tif --river-flow benches/raw/hydrology/glofas_era5_annual_mean.nc --height benches/raw/geology/ETOPO_2022_v1_60s_N90W180_surface.tif --method bilinear",
        "bench:resample:ecology-ref:with-soil": "python3 benches/scripts/resample.py --module ecology-ref --centroids benches/data/cell_centroids.csv --output benches/data/ecology_ref.bin --tree-cover benches/raw/ecology/mod44b_tree_cover.tif --non-tree-cover benches/raw/ecology/mod44b_non_tree_cover.tif --bare-cover benches/raw/ecology/mod44b_non_vegetated.tif --landcover benches/raw/ecology/mcd12q1_lc_type1.tif --landuse benches/raw/ecology/mcd12q1_lc_prop2.tif --temperature benches/raw/climate/worldclim_tavg_annual_c.tif --precipitation benches/raw/climate/worldclim_prec_annual_mm.tif --river-flow benches/raw/hydrology/glofas_era5_annual_mean.nc --height benches/raw/geology/ETOPO_2022_v1_60s_N90W180_surface.tif --soil-dir benches/raw/ecology/soilgrids --soil-suffix 0p1deg --soil-w-0-5 5 --soil-w-5-15 3.5 --soil-w-15-30 1.5 --method bilinear",
        "bench:resample:hydro-input": "python3 benches/scripts/resample.py --module hydro-input --centroids benches/data/cell_centroids.csv --output benches/data/hydro_input.bin",
        "bench:resample:hydro-ref": "python3 benches/scripts/resample.py --module hydro-ref --centroids benches/data/cell_centroids.csv --output benches/data/hydro_ref.bin",
        "bench:resample:terrain": "python3 benches/scripts/resample.py --module terrain --centroids benches/data/cell_centroids.csv --output benches/data/terrain_ref.bin",
        "bench:raw:prune:recoverable:dry-run": "bash benches/scripts/prune-recoverable-raw.sh",
        "bench:raw:prune:recoverable": "bash benches/scripts/prune-recoverable-raw.sh --apply",
        "wasm:build": "npm run terrain:sync && wasm-pack build rust --target web --out-dir ../generated/wasm/web --release",
        "wasm:build:dev": "npm run terrain:sync && wasm-pack build rust --target web --out-dir ../generated/wasm/web --dev",
        "wasm:build:dev:no-sync": "wasm-pack build rust --target web --out-dir ../generated/wasm/web --dev"
    },
    "dependencies": {
        "blessed": "^0.1.81",
        "blessed-contrib": "^4.11.0",
        "three": "^0.180.0"
    },
    "devDependencies": {
        "@types/blessed": "^0.1.27",
        "@types/node": "^25.5.0",
        "@types/three": "^0.183.1",
        "eslint": "^9.39.4",
        "eslint-plugin-import": "^2.32.0",
        "globals": "^17.4.0",
        "typescript": "^6.0.2",
        "vite": "^7.1.9"
    }
}
