{
    "name": "frey-day020",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "runtime:sync": "node tools/sync/sync-runtime-params.mjs",
        "geology:sync": "node tools/sync/sync-geology-params.mjs",
        "runtime-params:sync": "npm run runtime:sync",
        "geology-params:sync": "npm run geology:sync",
        "dev": "npm run runtime:sync && npm run geology:sync && node tools/dev/dev-hotreload.mjs",
        "build": "npm run runtime:sync && npm run wasm:build && vite build --config web/vite.config.js",
        "preview": "vite preview --config web/vite.config.js",
        "lint:web": "eslint \"web/src/**/*.js\"",
        "bench": "node tools/bench/bench.mjs",
        "bench:dev": "npm run wasm:build:dev:no-sync && node tools/bench/bench.mjs",
        "perf:baseline": "npm run bench:dev -- --ticks 16 --seed alpha --no-geometry --sample-interval 4 --out test/perf/bench-baseline.json",
        "perf:gate": "npm run bench:dev -- --ticks 16 --seed alpha --no-geometry --sample-interval 4 --baseline test/perf/bench-baseline.json --threshold 0.1",
        "seed:regression": "node tools/bench/seed-regression.mjs",
        "seed:regression:dev": "npm run wasm:build:dev:no-sync && node tools/bench/seed-regression.mjs",
        "seed:gate:quick": "npm run seed:regression:dev -- --seeds alpha,beta,gamma,delta --ticks 16 --baseline test/seed-regression/seed-regression-quick-baseline.json --check --threshold 0.005 --threshold-top10-river-flux-sum 0.01",
        "seed:gate:heavy": "npm run seed:regression:dev -- --seeds alpha,beta,gamma,delta,eta,theta,kappa,mu --ticks 24 --baseline test/seed-regression/seed-regression-heavy-baseline.json --check --threshold 0.005 --threshold-top10-river-flux-sum 0.01",
        "bench:dump-centroids": "node tools/bench/dump-cell-centroids.mjs --level 6 --out bench/data/cell_centroids.csv",
        "bench:fetch:era5": "CDSAPI_RC=.cdsapirc python3 tools/bench/fetch-era5-land-monthly.py --start-year 1970 --end-year 2000 --out data/raw/climate/era5_land_monthly_1970_2000.zip",
        "bench:fetch:glofas": "python3 tools/bench/fetch-glofas-historical.py --start-year 1979 --end-year 2000 --out-dir data/raw/hydrology/glofas_raw --system-version version_4_0 --hydrological-model lisflood",
        "bench:prepare:era5": "python3 tools/bench/prepare-era5-land-climate.py --input data/raw/climate/era5_land_monthly_1970_2000.zip --start-year 1970 --end-year 2000 --out data/raw/climate/era5_land_annual_1970_2000.nc",
        "bench:prepare:glofas": "python3 tools/bench/prepare-glofas-hydrology.py --input-dir data/raw/hydrology/glofas_raw --output data/raw/hydrology/glofas_era5_annual_mean.nc",
        "bench:prepare:worldclim": "python3 tools/bench/prepare-worldclim-climate.py --input-dir data/raw/climate --out-temperature data/raw/climate/worldclim_tavg_annual_c.tif --out-precipitation data/raw/climate/worldclim_prec_annual_mm.tif",
        "bench:resample:climate": "python3 tools/bench/resample.py --module climate --centroids bench/data/cell_centroids.csv --output bench/data/climate_ref.bin",
        "bench:resample:hydro-input": "python3 tools/bench/resample.py --module hydro-input --centroids bench/data/cell_centroids.csv --output bench/data/hydro_input.bin",
        "bench:resample:hydro-ref": "python3 tools/bench/resample.py --module hydro-ref --centroids bench/data/cell_centroids.csv --output bench/data/hydro_ref.bin",
        "bench:resample:terrain": "python3 tools/bench/resample.py --module terrain --centroids bench/data/cell_centroids.csv --output bench/data/terrain_ref.bin",
        "wasm:build": "npm run geology:sync && wasm-pack build rust --target web --out-dir ../generated/wasm/web --release",
        "wasm:build:dev": "npm run geology:sync && wasm-pack build rust --target web --out-dir ../generated/wasm/web --dev",
        "wasm:build:dev:no-sync": "wasm-pack build rust --target web --out-dir ../generated/wasm/web --dev"
    },
    "dependencies": {
        "three": "^0.180.0"
    },
    "devDependencies": {
        "eslint": "^9.39.4",
        "eslint-plugin-import": "^2.32.0",
        "vite": "^7.1.9"
    }
}
